<?xml version="1.0"?>
<sdf version="1.9">
  <model name="qr_marker">
    <static>true</static>
    <link name="link">
      <visual name="qr">
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>4 4</size>
          </plane>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <pbr>
            <metal>
              <albedo_map>model://qr_marker/materials/textures/qr.png</albedo_map>
              <roughness>1</roughness>
              <metalness>0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
